# Copia a backend/.env (el backend lo lee desde su directorio de trabajo). Todas opcionales.
HLSWEB_DOWNLOAD_DIR=downloads
HLSWEB_MAX_CONCURRENT_JOBS=2
HLSWEB_SEGMENT_WORKERS=8
# SOLO desarrollo/tests: desactiva la protección SSRF (permite localhost)
HLSWEB_ALLOW_PRIVATE_URLS=false
# Con el proxy de Vite no hace falta CORS. Ej: ["https://app.example"]
HLSWEB_CORS_ORIGINS=[]
HLSWEB_LOG_LEVEL=INFO
# Reintentos de red por petición/segmento (backoff exponencial, tope 8 s) y espera base
HLSWEB_NETWORK_RETRIES=5
HLSWEB_RETRY_BACKOFF=0.5
# SOLO desarrollo: escenarios simulados en http://debug.test/<escenario> (ver docs/DEBUGGING.md)
HLSWEB_DEBUG=false
# Historial de descargas (SQLite). Por defecto: <HLSWEB_DOWNLOAD_DIR>/hlsweb.db
# HLSWEB_DB_PATH=downloads/hlsweb.db
